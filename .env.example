# ==============================================================================
# PostgreSQL Connection Credentials
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# PostgreSQL Target Schema (required: jiostar_data)
DB_SCHEMA=jiostar_data

# ==============================================================================
# Folder Configurations
# Multiple folders can be provided as a comma-separated, semicolon-separated,
# or JSON-formatted list of relative or absolute directory paths.
# The table name in PostgreSQL will match each folder's name.
# ==============================================================================
DATA_FOLDERS=Data/december_internal_ca_data,Data/december_internal_india_data,Data/december_internal_sg_data

# ==============================================================================
# Ingestion Settings
# ==============================================================================
# Number of rows to process and load per batch (50,000 is optimal for COPY)
BATCH_SIZE=50000

# Action if table already exists in the schema: 'append' or 'replace'
TABLE_IF_EXISTS=append

# Preserve all columns as raw strings (recommended for ELT/ETL bronze layers to avoid type conversion loss)
PRESERVE_RAW_STRINGS=true

