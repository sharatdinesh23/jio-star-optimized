# ==============================================================================
# PostgreSQL Connection Credentials
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# PostgreSQL Target Schema
DB_SCHEMA=jiostar_data

# ==============================================================================
# Entity Data Folders / Links (4 Entities: India, UK, Singapore, Canada)
# Each mapped entity will create/load into: schema_name.internal_<country_name>_data
# - jiostar_data.internal_india_data
# - jiostar_data.internal_uk_data
# - jiostar_data.internal_singapore_data
# - jiostar_data.internal_canada_data
# ==============================================================================
DATA_FOLDER_INDIA=Data/december_internal_india_data
DATA_FOLDER_UK=
DATA_FOLDER_SINGAPORE=Data/december_internal_sg_data
DATA_FOLDER_CANADA=Data/december_internal_ca_data

# Optional combined list (auto-mapped or key=value):
# DATA_FOLDERS=Data/december_internal_ca_data,Data/december_internal_india_data,Data/december_internal_sg_data

# ==============================================================================
# Batch Ingestion Settings
# ==============================================================================
# Number of rows to process and load per batch (50,000 - 100,000 is optimal for COPY)
BATCH_SIZE=100000

# Action if table already exists in the schema: 'append' or 'replace'
TABLE_IF_EXISTS=append

# Preserve all columns as raw strings (recommended for ELT/ETL bronze layers)
PRESERVE_RAW_STRINGS=true

# CSV field size limit in bytes (64MB default)
CSV_FIELD_SIZE_LIMIT=67108864
